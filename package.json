{
  "name": "agent-zen",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "agent-zen": "AGENT_ZEN_PREFIX=$HOME/.local bun run cli/index.ts",
    "dev": "vite",
    "bridge": "bun run server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:cli": "mkdir -p build/cli && bun build --compile cli/index.ts --outfile build/cli/agent-zen && bun build --compile server/index.ts --outfile build/cli/agent-zen-server",
    "install:cli": "./scripts/install-cli.sh",
    "build:macos": "./scripts/build-macos-app.sh",
    "release:macos": "./scripts/release-macos.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:server": "bun test ./server ./cli",
    "test:daemon": "./scripts/test-daemon-lifecycle.sh",
    "test:install-interruption": "./scripts/test-install-cli-interruption.sh",
    "test:memory": "./scripts/test-bridge-memory.sh",
    "test:parent-lifecycle": "./scripts/test-bridge-parent-lifecycle.sh",
    "test:native": "./scripts/test-native-contract.sh",
    "test:a11y": "playwright test --config playwright.config.ts",
    "test:a11y:live": "AGENT_ZEN_REQUIRE_LIVE=1 playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run typecheck:server && bun run test && bun run test:server && vite build"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "happy-dom": "^17.4.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "webreel": "0.1.4"
  },
  "patchedDependencies": {
    "@webreel/core@0.1.4": "patches/@webreel%2Fcore@0.1.4.patch"
  }
}
